# Public, non-secret build configuration only. Never place provider keys here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_DEV_ROUTES=true
EXPO_PUBLIC_ENABLE_EMAIL_AUTH=true
EXPO_PUBLIC_ENABLE_PAYMENTS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
# Public provider selector only. The OpenAI API key remains in Supabase secrets.
EXPO_PUBLIC_PHOTO_CHECK_PROVIDER=live
# Public URLs. Leave empty during development until the approved pages are live.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
# Public client DSN only. Keep the Sentry auth token in EAS secrets, never here.
EXPO_PUBLIC_SENTRY_DSN=
