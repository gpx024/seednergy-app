{
  "expo": {
    "name": "Seednergy",
    "slug": "seednergy",
    "version": "0.1.0",
    "icon": "./assets/app/icon.png",
    "orientation": "portrait",
    "scheme": "seednergy",
    "ios": {
      "bundleIdentifier": "com.seednergy.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seednergy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "monochromeImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#eeece7"
      }
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#eeece7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seednergy uses your selected plant photos for cycle-specific growth checks.",
          "cameraPermission": "Seednergy uses the camera so you can photograph your active grow cycle.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "seednergy-app",
          "organization": "seednergy"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7501ef91-43bd-4791-a6c4-a189f89824bc"
      }
    },
    "owner": "gpx024"
  }
}
